# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# BSC RPC endpoint (read-only is enough for dry-run).
# Public default works but use a private RPC (Ankr, QuickNode, ...) for speed.
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Private key of the trading wallet (0x...). REQUIRED ONLY for live trading.
# Leave empty to run in dry-run / paper mode.
PRIVATE_KEY=
